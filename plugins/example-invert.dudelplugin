{
    "format":  "dudel-rhai-extension",
    "version":  1,
    "api":  1,
    "id":  "dudel-example-invert",
    "name":  "Example invert",
    "author":  "Dudel",
    "release":  "1.0.0",
    "description":  "Invert RGB on the active layer while preserving alpha.",
    "capabilities":  [
                         "pixels.filter"
                     ],
    "source":  "// Dudel filter API v1. Channels are integers from 0 to 255.\nfn filter(r, g, b, a) {\n    [255 - r, 255 - g, 255 - b, a]\n}\n"
}